    "GameProviderCode": "EVOTF",
    "IntervalMinutes": 3,
    "IntervalMinutesMax": 60,
    "IntervalMinutesMinimum": 1,
    "LockMinute": 1.5
  },
  "NatsSetting": {
    "Group": "gp.gamerecord.schedule",
    "Subject": "gp.gamerecord.schedule.evotf"
  },
  "MongoSetting": {
    "ManagerName": "gp.gamerecord.database",
    "QueueName": "tgs.gp.gamerecord.database.round.evotf",
    "GlobPattern": "tgs.gp.gamerecord.database.round.evotf"
  }
}
